        // ================================================================
        // EXPIRY
        // ================================================================

        private static String getExpiryText(
                        ProductModel product) {

                if (!product.isExpiryTracking() ||
                                product.getExpiryDate() == null) {

                        return "-";
                }

                long days =
                                ChronoUnit.DAYS.between(
                                                LocalDate.now(),
                                                product.getExpiryDate());

                if (days < 0) {

                        return "EXPIRED";
                }

                if (days == 0) {

                        return "Today";
                }

                if (days <= 7) {

                        return days + " days";
                }

                return product.getExpiryDate().toString();
        }

        private static boolean isNearExpiry(
                        ProductModel product) {

                if (!product.isExpiryTracking() ||
                                product.getExpiryDate() == null) {

                        return false;
                }

                long days =
                                ChronoUnit.DAYS.between(
                                                LocalDate.now(),
                                                product.getExpiryDate());

                return days >= 0 &&
                                days <= 7;
        }

        private static String getExpiryColor(
                        ProductModel product) {

                if (!product.isExpiryTracking() ||
                                product.getExpiryDate() == null) {

                        return "#777777";
                }

                long days =
                                ChronoUnit.DAYS.between(
                                                LocalDate.now(),
                                                product.getExpiryDate());

                if (days < 0) {

                        return "#A91D1D";
                }

                if (days <= 7) {

                        return "#A94408";
                }

                return "#333333";
        }

        // ================================================================
        // STOCK
        // ================================================================

        private static boolean isLowStock(
                        ProductModel product) {

                return Integer.parseInt(product.getStockQuantity()) > 0 &&
                                Integer.parseInt(product.getStockQuantity()) <=
                                                Integer.parseInt(product.getLowStockLimit());
        }

        private static double calculateStockRatio(
                        ProductModel product) {

                if (Integer.parseInt(product.getStockQuantity()) <= 0) {
                        return 0;
                }

                if (Integer.parseInt(product.getLowStockLimit()) <= 0) {
                        return 1;
                }

                return Math.min(
                                1,
                                (double) Integer.parseInt(product.getStockQuantity()) /
                                                Integer.parseInt(product.getLowStockLimit()) * 3.0);
        }

        private static String getStockColor(
                        ProductModel product) {

                if (Integer.parseInt(product.getStockQuantity()) <= 0) {

                        return "#A91D1D";
                }

                if (isLowStock(product)) {

                        return "#F29B72";
                }

                return "#A94408";
        }

        // ================================================================
        // STATUS
        // ================================================================

        private static String getDisplayStatus(
                        ProductModel product) {

                if (Integer.parseInt(product.getStockQuantity()) <= 0 ||
                                "OUT_OF_STOCK".equalsIgnoreCase(
                                                product.getStatus())) {

                        return "Out of Stock";
                }

                if (isLowStock(product)) {

                        return "Low Stock";
                }

                if (isNearExpiry(product)) {

                        return "Near Expiry";
                }

                if ("INACTIVE".equalsIgnoreCase(
                                product.getStatus())) {

                        return "Inactive";
                }

                return "Active";
        }

        private static String getStatusTextColor(
                        ProductModel product) {

                String status =
                                getDisplayStatus(
                                                product);

                if ("Out of Stock".equals(status)) {
                        return "#A91D1D";
                }

                if ("Low Stock".equals(status) ||
                                "Near Expiry".equals(status)) {
                        return "#A94408";
                }

                if ("Inactive".equals(status)) {
                        return "#666666";
                }

                return "#246B3A";
        }

        private static String getStatusBackground(
                        ProductModel product) {

                String status =
                                getDisplayStatus(
                                                product);

                if ("Out of Stock".equals(status)) {
                        return "#FFDCDC";
                }

                if ("Low Stock".equals(status) ||
                                "Near Expiry".equals(status)) {
                        return "#FFF0E8";
                }

                if ("Inactive".equals(status)) {
                        return "#EAE8EC";
                }

                return "#E4F3E8";
        }

