                                                value);

                card.setPadding(
                                new Insets(
                                                10,
                                                14,
                                                10,
                                                14));

                card.setPrefWidth(
                                155);

                card.setMinWidth(
                                155);

                card.setStyle(
                                "-fx-background-color: white;" +
                                                "-fx-border-color: #DED5D0;" +
                                                "-fx-border-radius: 9px;" +
                                                "-fx-background-radius: 9px;");

                return card;
        }

        // ================================================================
        // UTILITY
        // ================================================================

        private static void setFixedWidth(
                        Region region,
                        double width) {

                region.setPrefWidth(
                                width);

                region.setMinWidth(
                                width);

                region.setMaxWidth(
                                width);
        }

        private static String safe(
                        String value) {

                return value == null
                                ? ""
                                : value;
        }
