        private static StackPane createHeaderCell(
                        String text,
                        double width) {

                Text label =
                                new Text(
                                                text);

                label.setStyle(
                                "-fx-font-size: 10px;" +
                                                "-fx-font-weight: bold;" +
                                                "-fx-fill: #555555;");

                StackPane box =
                                new StackPane(
                                                label);

                setFixedWidth(
                                box,
                                width);

                return box;
        }

