                                                "-fx-text-fill: #777777;");

                value.setStyle(
                                "-fx-font-size: 20px;" +
                                                "-fx-font-weight: bold;" +
                                                "-fx-text-fill: #222222;");

                VBox card =
                                new VBox(
                                                3,
